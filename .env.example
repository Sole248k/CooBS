# ==============================================================================
# Core Retail Banking Architecture - Environment Template (.env.example)
# Copy this file to .env (which is strictly git-ignored) for local development.
# In Staging / Production, inject high-entropy secrets from a secure secret vault.
# ==============================================================================

# Oracle Database Configuration (Master System of Record & Row Locks)
ORACLE_PORT=1522
ORACLE_OEM_PORT=5501
ORACLE_PASSWORD=SysPassword123!
APP_USER=core_user
APP_USER_PASSWORD=CorePassword123!
ORACLE_DATABASE=XEPDB1

# PostgreSQL Configuration (Immutable Forensic Audit & Compliance Store)
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=AuditPassword123!
POSTGRES_DB=audit_store

# Redis Configuration (Distributed Idempotency Lock & Balance Cache)
REDIS_PORT=6379

# Apache Kafka Configuration (KRaft Mode Event Streaming)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=4L62EnNxTQl-GHmeeAhCwA

# Kafka UI Configuration
KAFKA_UI_PORT=8088

# Audit Service Configuration
AUDIT_PORT=8085

# Security, JWT & CORS Configuration
# Standard 256-bit HMAC-SHA256 test key (Replace in staging/production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Shared secret the risk engine accepts in the X-Internal-Secret header (local test value).
# Required: risk-engine does not start without it. scripts/benchmark_risk_eval sends the same value.
INTERNAL_SERVICE_SECRET=coobs-risk-internal-secret-2026

# ==============================================================================
# Multi-Factor Authentication (MFA / 2FA) & OTP Delivery API Keys
# ==============================================================================
# Global toggle for 2FA requirement (false for quick dev/tests, true to enforce)
MFA_ENABLED=false
MFA_DEFAULT_CHANNEL=SMS

# SMS Provider Configuration (Options: MOCK, SEMAPHORE, TWILIO)
SMS_PROVIDER=MOCK
# Semaphore (Philippine Telco Gateway)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=COREBANK
# Twilio (Global Telco Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Email / SMTP Configuration (Options: MOCK, SMTP)
EMAIL_PROVIDER=MOCK
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@corebank.ph

# Expansion services (profile: expansion). Defaults shown; uncomment to override.
# Variable names each service reads are listed in contracts/runtime/RUNTIME_SETTINGS.md.
# The cloud PostgreSQL uses POSTGRES_PASSWORD above.
# POSTGRES_CLOUD_PORT=5435
# POSTGRES_CLOUD_USER=postgres
# Only for docker-compose.azure-sql.yml (cloud databases on SQL Server): the sa password.
# SQL Server refuses a password under 8 characters or without upper case, lower case and a digit.
CLOUD_DB_PASSWORD=CloudDbPassword123!
# SQLSERVER_CLOUD_PORT=1433
# CUSTOMER_SERVICE_PORT=8089
# TRANSACTION_SERVICE_PORT=8090
# ORCHESTRATION_SERVICE_PORT=8091
# RISK_ENGINE_PORT=8092
# BATCH_SERVICE_PORT=8093
