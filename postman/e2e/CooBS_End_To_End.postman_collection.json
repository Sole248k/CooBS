    {
      "name": "07. Reversal Saga & Compensation Flow (FIN-104)",
      "item": [
        {
          "name": "7.1 Execute Transfer for Reversal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'idem-rev-prep-' + Date.now();",
                  "pm.collectionVariables.set(\"reversal_prep_idempotency_key\", key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set(\"reversal_target_tx_id\", data.transactionId);",
                  "pm.collectionVariables.set(\"reversal_target_ref_no\", data.referenceNo);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{reversal_prep_idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountNumber\": \"ACC_10000002\",\n  \"destinationBankCode\": \"COOBS\",\n  \"amount\": \"500.00\",\n  \"currency\": \"PHP\",\n  \"category\": \"TRANSFER\",\n  \"remarks\": \"Transfer to be reversed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfers"]
            }
          }
        },
        {
          "name": "7.2 Staff Reversal Request (T5 / O2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'idem-rev-exec-' + Date.now();",
                  "pm.collectionVariables.set(\"reversal_exec_idempotency_key\", key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted or 200 OK\", function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Reversal accepted with transactionId\", function () {",
                  "    pm.expect(data.transactionId).to.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set(\"dynamic_reversal_id\", data.transactionId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teller_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{reversal_exec_idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Disputed transaction by customer\",\n  \"actorId\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{reversal_target_tx_id}}/reversal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{reversal_target_tx_id}}", "reversal"]
            }
          }
        },
        {
          "name": "7.3 Verify Original Transaction State is REVERSED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Original transaction status updated to REVERSED\", function () {",
                  "    pm.expect([\"REVERSED\", \"COMPENSATED\"]).to.include(data.status);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teller_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{reversal_target_tx_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{reversal_target_tx_id}}"]
            }
          }
        }
      ]
