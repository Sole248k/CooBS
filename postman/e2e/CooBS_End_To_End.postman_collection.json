{
  "info": {
    "_postman_id": "coobs-e2e-master-suite-v1",
    "name": "CooBS Platform \u2014 End-to-End Master Test Suite (11 Services)",
    "description": "Comprehensive End-to-End integration test suite for the CooBS 11-microservice platform.\nCovers Ingress Gateway, Authentication, Customer 360, Account Management, 11-Stage Distributed Transfer Saga, Reversal & Compensation Saga (FIN-104), Double-Entry Ledgering, In-App Notifications, and SHA-256 Cryptographic Audit Chain.\n\nDesigned to run using 'CooBS Local Environment' (postman/CooBS_Local.postman_environment.json) or in CI via Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
