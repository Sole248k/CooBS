          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Login successful and MFA not required\", function () {",
                  "    pm.expect(data.mfaRequired).to.be.false;",
                  "    pm.expect(data.authData).to.be.an(\"object\");",
                  "    pm.expect(data.authData.accessToken).to.not.be.empty;",
                  "    pm.expect(data.authData.roles).to.include(\"ROLE_CUSTOMER\");",
                  "});",
                  "pm.environment.set(\"customer_token\", data.authData.accessToken);",
                  "pm.collectionVariables.set(\"customer_token\", data.authData.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
