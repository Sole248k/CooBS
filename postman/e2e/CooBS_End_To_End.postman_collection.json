    {
      "name": "05. Distributed Transfer Saga (Transaction + Orchestration)",
      "item": [
        {
          "name": "5.1 Initiate Fund Transfer (T1 - Returns 202 INITIATED)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'idem-' + Date.now() + '-' + Math.floor(Math.random() * 100000);",
                  "pm.environment.set(\"last_idempotency_key\", key);",
                  "pm.collectionVariables.set(\"transfer_idempotency_key\", key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Transfer response includes transactionId and INITIATED status\", function () {",
                  "    pm.expect(data.transactionId).to.not.be.empty;",
                  "    pm.expect(data.status).to.eql(\"INITIATED\");",
                  "    pm.expect(data.amount).to.eql(\"2500.00\");",
                  "});",
                  "pm.collectionVariables.set(\"dynamic_transfer_id\", data.transactionId);",
                  "pm.collectionVariables.set(\"dynamic_reference_no\", data.referenceNo);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transfer_idempotency_key}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-e2e-corr-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountNumber\": \"ACC_10000002\",\n  \"destinationBankCode\": \"COOBS\",\n  \"amount\": \"2500.00\",\n  \"currency\": \"PHP\",\n  \"category\": \"TRANSFER\",\n  \"remarks\": \"E2E Verification Transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfers"]
            }
          }
        },
        {
          "name": "5.2 Idempotency Replay (T1 - Same Key returns 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Idempotent replay returns 200 OK or 202 Accepted\", function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Returns identical transactionId and referenceNo\", function () {",
                  "    pm.expect(data.transactionId).to.eql(pm.collectionVariables.get(\"dynamic_transfer_id\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transfer_idempotency_key}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-e2e-corr-02"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountNumber\": \"ACC_10000002\",\n  \"destinationBankCode\": \"COOBS\",\n  \"amount\": \"2500.00\",\n  \"currency\": \"PHP\",\n  \"category\": \"TRANSFER\",\n  \"remarks\": \"E2E Verification Transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfers"]
            }
          }
        },
        {
          "name": "5.3 Verify Transaction Details (T2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Transaction progressed to POSTED or COMPLETED\", function () {",
                  "    pm.expect([\"POSTED\", \"COMPLETED\", \"PROCESSING\"]).to.include(data.status);",
                  "    pm.expect(data.amount).to.eql(\"2500.00\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{dynamic_transfer_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{dynamic_transfer_id}}"]
            }
          }
        },
        {
          "name": "5.4 Verify 11-Stage Saga Timeline (T3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Timeline has stages array\", function () {",
                  "    pm.expect(data.stages).to.be.an(\"array\");",
                  "    pm.expect(data.stages.length).to.be.at.least(1);",
                  "});",
                  "pm.test(\"Latest stage outcome is PASSED\", function () {",
                  "    var latest = data.stages[data.stages.length - 1];",
                  "    pm.expect(latest.outcome).to.eql(\"PASSED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teller_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{dynamic_transfer_id}}/timeline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{dynamic_transfer_id}}", "timeline"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Atomic Double-Entry Ledger Verification",
      "item": [
        {
          "name": "6.1 Verify Sender Debited Exactly 2500.00",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
