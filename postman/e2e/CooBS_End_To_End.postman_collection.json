    {
      "name": "04. Account Discovery & Initial Balances",
      "item": [
        {
          "name": "4.1 Capture Initial Sender Balance (John Doe - Acc 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var list = pm.response.json();",
                  "var accounts = Array.isArray(list) ? list : list.content;",
                  "pm.test(\"John Doe has active accounts\", function () {",
                  "    pm.expect(accounts.length).to.be.at.least(1);",
                  "});",
                  "var acc1 = accounts.find(a => a.accountId === 1 || a.accountNumber === 'ACC_10000001') || accounts[0];",
                  "pm.collectionVariables.set(\"initial_sender_balance\", String(acc1.availableBalance));",
                  "console.log(\"Captured Initial Sender Balance: \" + acc1.availableBalance);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
